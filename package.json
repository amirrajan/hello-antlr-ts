{
  "name": "hello-antlr-ts",
  "version": "1.0.0",
  "main": "src/main.ts",
  "scripts": {
    "build:tsc": "tsc",
    "build:webpack": "webpack",
    "build": "npm run build:tsc && npm run build:webpack",
    "start": "webpack serve",
    "test": "jest",
    "generate": "java -jar ./bin/antlr-4.13.1-complete.jar -Dlanguage=TypeScript ./src/grammar/Expr.g4"
